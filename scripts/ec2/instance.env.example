# Copy this file to scripts/ec2/instance.env (gitignored) and fill in your values.
# Used by launch_chain.sh / sync_results.sh / stop_instance.sh / status.sh on the LAPTOP side.

# AWS
AWS_REGION=us-east-1
EC2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx

# SSH
EC2_KEY_PATH=$HOME/.ssh/self-rec-research-ec2.pem
EC2_USER=ubuntu

# Repo location on the instance
EC2_REMOTE_REPO=/home/ubuntu/self-rec-research

# Optional: pin a hostname/EIP. Leave blank to resolve dynamically each run via
# `aws ec2 describe-instances --instance-ids $EC2_INSTANCE_ID`.
EC2_HOST=
